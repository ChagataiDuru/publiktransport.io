    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
